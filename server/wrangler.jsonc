{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firelink-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["*/5 * * * *", "27 * * * *"] },
  "assets": {
    "directory": "../organizer/build",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*", "/v1/*", "/health", "/.well-known/*"],
  },
  "vars": {
    "GEOCODER_URL": "https://nominatim.openstreetmap.org",
    "APP_ENV": "local",
    "ORGANIZER_DEMO": "true",
    "MOCK_AUTH": "true",
    "RP_ID": "localhost",
    "PASSKEY_ORIGINS": "http://localhost:8787",
    "APPLE_APP_ID": "",
    "ANDROID_SHA256": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "firelink-dev",
      "database_id": "local-firelink",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "firelink-dev-files" }],
  "env": {
    "staging": {
      "name": "firelink-demo",
      "triggers": { "crons": ["*/5 * * * *", "27 * * * *"] },
      "vars": {
        "GEOCODER_URL": "https://nominatim.openstreetmap.org",
        "APP_ENV": "staging",
        "ORGANIZER_DEMO": "true",
        "MOCK_AUTH": "false",
        "RP_ID": "",
        "PASSKEY_ORIGINS": "",
        "APPLE_APP_ID": "",
        "ANDROID_SHA256": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "firelink-organizer-staging",
          "database_id": "0e8f3e9f-cfd5-408a-bd6d-69ba8269b2e5",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "firelink-organizer-staging-files",
        },
      ],
    },
    "production": {
      "name": "firelink-production",
      "triggers": { "crons": ["*/5 * * * *", "27 * * * *"] },
      "vars": {
        "GEOCODER_URL": "https://nominatim.openstreetmap.org",
        "APP_ENV": "production",
        "ORGANIZER_DEMO": "false",
        "MOCK_AUTH": "false",
        "RP_ID": "",
        "PASSKEY_ORIGINS": "",
        "APPLE_APP_ID": "",
        "ANDROID_SHA256": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "firelink-production",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "firelink-production-files" },
      ],
    },
  },
}
