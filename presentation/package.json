{
  "name": "firelink-presentation",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node start.ts",
    "serve": "node server.ts",
    "test": "node --test test/*.test.ts",
    "verify": "node verify.ts",
    "verify:browser": "node browser-check.ts",
    "screenshots": "node screenshots.ts",
    "screenshots:update": "node start.ts --screenshots",
    "doctor": "node start.ts --check",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json"
  },
  "dependencies": {
    "beercss": "5.0.3",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
