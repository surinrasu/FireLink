              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/applications": {
      "get": {
        "summary": "本人报名记录与回应",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Application"
                  }
                }
              }
            }
          },
          "default": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "按选定字段和联系方式授权报名",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "const": "pending"
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "taskId": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "username",
                        "pronouns",
                        "realName",
                        "age",
                        "gender",
                        "region",
                        "body",
                        "equipment",
                        "skills"
                      ]
                    }
                  },
                  "contactFields": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "phone",
                        "wechat",
                        "email"
                      ]
                    }
                  },
                  "consentVersion": {
                    "const": 1
                  }
                },
                "required": [
                  "taskId",
                  "fields",
                  "contactFields",
                  "consentVersion"
                ]
              }
            }
          }
        }
      }
    },
