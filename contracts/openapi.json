{
  "openapi": "3.1.0",
  "info": {
    "title": "FireLink Volunteer API",
    "version": "0.1.0",
    "description": "中国大陆志愿者客户端；当前短信和实名为模拟服务。所有日期按 UTC ISO 8601 传输，地图坐标为 WGS84。"
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "本地开发"
    }
  ],
  "paths": {
    "/v1/config": {
      "get": {
        "summary": "服务能力与模拟标记",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mockAuth": {
                      "type": "boolean"
                    },
                    "passkeys": {
                      "type": "boolean"
                    },
                    "region": {
                      "type": "string"
                    },
                    "consentVersion": {
                      "type": "integer"
                    },
                    "mockIdentity": {
                      "type": "object",
                      "description": "仅本地/测试开启 mockAuth 时提供，客户端通过本地通知送达",
                      "properties": {
                        "realName": {
                          "type": "string"
                        },
                        "idNumber": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "realName",
                        "idNumber"
                      ]
                    }
                  },
                  "required": [
                    "mockAuth",
                    "passkeys",
                    "region",
                    "consentVersion"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sms": {
      "post": {
        "summary": "发送模拟短信验证码",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challengeId": {
                      "type": "string"
                    },
                    "mockCode": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "challengeId",
                    "mockCode",
                    "message"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string"
                  }
                },
                "required": [
                  "phone"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/auth/verify": {
      "post": {
        "summary": "验证验证码；新用户返回注册凭证",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Session"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "registrationToken": {
                          "type": "string"
                        },
                        "needsRegistration": {
                          "const": true
                        }
                      },
                      "required": [
                        "registrationToken",
                        "needsRegistration"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "challengeId": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                },
                "required": [
                  "challengeId",
                  "code"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "summary": "确认注册并使用模拟实名",
        "security": [],
        "responses": {
          "201": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "registrationToken": {
                    "type": "string"
                  },
                  "consent": {
                    "const": true
                  },
                  "realName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "idNumber": {
                    "type": "string",
                    "pattern": "^[0-9]{17}[0-9Xx]$",
                    "description": "本地仅接受 config.mockIdentity 中的虚构资料；不存储身份证号"
                  }
                },
                "required": [
                  "registrationToken",
                  "consent",
                  "realName",
                  "idNumber"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/incidents": {
      "get": {
        "summary": "按最近更新时间倒序列出火情及任务",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Incident"
                  }
                }
              }
            }
          },
          "default": {
            "description": "请求失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{id}": {
      "get": {
        "summary": "任务详情及发布者身份",
