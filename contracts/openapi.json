                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/articles": {
      "get": {
        "summary": "教程及内容块",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
